# Copy to .env.local for development.
#
# Everything prefixed with VITE_ is embedded in the CLIENT BUNDLE at build
# time and is visible to anyone who opens devtools. Never put a secret here.

# Leave empty while there is no backend - the app serves the seed catalog
# from src/api/mock/. Set it once the API exists, e.g. https://api.contoso.com
VITE_API_BASE_URL=

# Force the seed catalog even when an API base URL is set. Useful for demos.
VITE_USE_MOCK_API=true

# Dev-server proxy target for /api/* calls (see vite.config.js).
VITE_API_PROXY_TARGET=http://localhost:3000
